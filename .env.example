# --- Judge model (Azure OpenAI) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_USE_MANAGED_IDENTITY=true
# Only for a user-assigned managed identity:
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# Legacy local fallback only: set managed identity false and provide AZURE_OPEN_AI_KEY.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.1
API_VERSION=2025-04-01-preview

# --- Agent under test (default registry endpoint and LangGraph adapter) ---
# Set the intended agent URL here in .env:
# LANGGRAPH_BASE_URL=https://<your-agent-host>
# An explicit EVAL_APPLICATIONS registry below overrides this per application.
LANGGRAPH_BASE_URL=http://127.0.0.1:2026
LANGGRAPH_ASSISTANT_ID=chat
LANGGRAPH_BEARER_TOKEN=
LANGGRAPH_TIMEOUT_SECONDS=300

# --- Storage backend: langsmith (default) or cosmos ---
# cosmos persists datasets/runs/rows in Azure Cosmos DB using Azure AD credentials
# (managed identity, or the local Azure credential chain such as `az login`).
# The database and its datasets, runs and rows containers must already exist.
EVAL_STORAGE=langsmith
# AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
# AZURE_COSMOS_DATABASE=eval-framework

# --- LangSmith storage (EVAL_STORAGE=langsmith) ---
# LANGSMITH_API_KEY is honored as a fallback when LANGSMITH_EVALS_KEY is unset.
LANGSMITH_EVALS_KEY=<langsmith-api-key>

# --- LangSmith tracing of the eval pipeline ITSELF (Tracing tab) ---
# NOT the same thing as storage: storage (runs/rows/feedback) uses
# LANGSMITH_EVALS_KEY above and is always on; tracing emits the eval app's OWN
# per-case traces (case chain -> agent-call span + judge LLM spans with
# prompts/latency/tokens) to the LANGSMITH_PROJECT tracing project.
# Set LANGSMITH_TRACING=true (and LANGSMITH_API_KEY) to enable; false/unset
# sends no traces.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=<langsmith-api-key-for-tracing>
LANGSMITH_PROJECT=eval-framework

# --- Logging (service and UI; see service/logging_config.py) ---
# LOG_LEVEL: DEBUG shows every agent call, judge call and storage write.
# LOG_LEVEL=INFO
# LOG_FORMAT: json = one JSON object per line (Docker log drivers, shippers).
# LOG_FORMAT=text
# LOG_FILE: rotating file in addition to stderr (Docker image: /app/logs/…).
# LOG_FILE=logs/eval-service.log

# --- Applications registry override (optional; JSON list).
#     When unset, the active "va" entry and inactive "va-dev" alias use
#     LANGGRAPH_BASE_URL above. Use this only to customize the registry. ---
# EVAL_APPLICATIONS=[{"key": "my-agent", "display_name": "My agent", "deployment_url": "http://127.0.0.1:2026", "assistant_id": "chat", "auth_profile": "caller-passthrough", "is_active": true}]

# --- Eval service URL (consumed by the Streamlit UI) ---
EVAL_API_URL=http://127.0.0.1:8100

# --- SSO (Entra ID) — the service mints an HMAC-signed httpOnly eval_session
#     cookie on localhost; the Streamlit UI verifies it with AUTH_SECRET.
#     Redirect URIs http://localhost:8100/auth/callback (native) and http://localhost:8501/auth/callback (docker) must be
#     registered on the App Registration. ---
ENTRA_TENANT_ID=<entra-tenant-guid>
ENTRA_CLIENT_ID=<app-registration-client-id>
ENTRA_CLIENT_SECRET=<app-registration-client-secret>
# Required with SSO; must be identical for the service and the UI. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
API_SCOPE=api://<app-registration-client-id>/access_as_user
# Escape hatch: skip the login gate and restore the manual sidebar bearer field.
# DISABLE_AUTH=1
# Where /auth/login and /auth/logout land when no `next` is given.
# STREAMLIT_URL=http://localhost:8501
# Behind HTTPS: set STREAMLIT_URL to the public https:// origin and register this callback.
# AUTH_REDIRECT_URI=https://<your-host>/auth/callback
# Docker image: nginx requires a valid eval_session cookie on /api/* (except
# /api/health). Keep this on for any shared host.
AUTH_REQUIRE_API_SESSION=true

# --- Runner tuning ---
# Metrics available in the Run selector and allowed by the API (use metric keys).
# Unset/blank allows all nine. Example subset: correctness,relevance,groundedness
# Restart the API after editing .env. Shell/container environment takes precedence.
EVAL_ALLOWED_METRICS=correctness,relevance,groundedness,bias,retrieval,context_precision,context_recall,fallback,jailbreak
# EVAL_RUN_CONCURRENCY=4
# EVAL_JUDGE_CONCURRENCY=2
# EVAL_JUDGE_MIN_INTERVAL_MS=1000
# EVAL_JUDGE_MAX_ATTEMPTS=5
# EVAL_JUDGE_RETRY_BUDGET_S=180
# EVAL_JUDGE_TIMEOUT_S=60
# EVAL_JUDGE_MAX_OUTPUT_TOKENS=2048
# EVAL_JUDGE_MAX_PROMPT_BYTES=128000
